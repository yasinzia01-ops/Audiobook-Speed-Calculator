---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import '../styles/elementor/elementor-post-2321.css';

const updated = 'September 29, 2026';

const seo = {
  title: 'Terms & Condition - Audiobook Speed Calculator',
  ogType: 'article',
  modified: '2026-09-29T00:00:00+00:00',
  twitter: [
    ['twitter:label1', 'Est. reading time'],
    ['twitter:data1', '4 minutes'],
  ] as [string, string][],
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms & Condition',
    url: 'https://audiobookspeedcalculator.org/terms-condition/',
    datePublished: '2026-06-15T14:02:02',
    dateModified: '2026-09-29T00:00:00',
    author: {
      '@type': 'Person',
      name: 'Sarah Connell',
      url: 'https://audiobookspeedcalculator.org/author/sarah-thelistener',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Audiobook Speed Calculator',
      logo: {
        '@type': 'ImageObject',
        url: 'https://audiobookspeedcalculator.org/images/Gemini_Generated_Image_kh8fhrkh8fhrkh8f.webp',
      },
    },
    isPartOf: { '@type': 'WebSite', '@id': 'https://audiobookspeedcalculator.org' },
  },
];

const sections = [
  {
    title: 'Acceptance of These Terms',
    html: `<p>These Terms & Conditions apply to your use of audiobookspeedcalculator.org (the "site"). By using the site you agree to them. If you do not agree, please do not use the site.</p>`,
  },
  {
    title: 'About the Service',
    html: `<p>The site provides free tools and information for audiobook listeners, including the Audiobook Speed Calculator, the Libby Speed Calculator, the audiobook speed chart, an audiobook length list and listening guides. The site is free to use and does not require an account.</p>`,
  },
  {
    title: 'Results Are Estimates',
    html: `<p>Calculator results are estimates for planning purposes. Actual listening time can differ because of how each app applies playback speed, chapter breaks, pauses and rounding.</p>
<ul>
<li>Audiobook lengths in our lists are approximate and can vary by edition, narrator and platform.</li>
<li>Library loan periods, renewals and holds (for example in Libby or OverDrive) are set by each library and can change.</li>
<li>Speed and comprehension guidance is general information, not professional, medical or educational advice.</li>
</ul>
<p>Always check the details shown in your own audiobook app or library account.</p>`,
  },
  {
    title: 'Acceptable Use',
    html: `<p>You agree not to:</p>
<ul>
<li>Use the site in any way that breaks the law or harms other people.</li>
<li>Try to disrupt, overload or gain unauthorised access to the site or its hosting.</li>
<li>Copy the site's content in bulk, or scrape it automatically in a way that burdens the site.</li>
<li>Present our tools or content as your own, or remove notices of ownership.</li>
</ul>`,
  },
  {
    title: 'Intellectual Property',
    html: `<p>The site's text, calculators, charts, design and images belong to Audiobook Speed Calculator or its licensors and are protected by copyright. You may link to any page and quote short passages with a link back to the source. Any other reuse needs our written permission.</p>`,
  },
  {
    title: 'Trademarks and Affiliation',
    html: `<p>Audible, Libby, OverDrive, Spotify, Apple Books, Hoopla, Scribd and other product names mentioned on the site are trademarks of their respective owners. We use them only to describe compatibility and features. The site is independent and is not affiliated with, endorsed by or sponsored by any of these companies.</p>`,
  },
  {
    title: 'Third-Party Links and Advertising',
    html: `<p>The site links to other websites and may display advertising, including ads from Google AdSense. We do not control third-party websites or ads and are not responsible for their content, products or practices. Your dealings with them are between you and the third party. See our <a href="/privacy-policy/">Privacy Policy</a> for how advertising cookies may be used.</p>`,
  },
  {
    title: 'Disclaimer of Warranties',
    html: `<p>The site and all tools are provided "as is" and "as available", without warranties of any kind, express or implied, including accuracy, fitness for a particular purpose and uninterrupted availability. We may change, suspend or remove any part of the site at any time.</p>`,
  },
  {
    title: 'Limitation of Liability',
    html: `<p>To the fullest extent permitted by law, Audiobook Speed Calculator is not liable for any indirect, incidental or consequential loss, or for any loss arising from reliance on calculator results or site content, such as a library loan expiring before you finish a book. Nothing in these terms limits liability that cannot be limited under applicable law.</p>`,
  },
  {
    title: 'Changes to These Terms',
    html: `<p>We may update these Terms & Conditions from time to time. The new version will be posted on this page with an updated "Last updated" date. Continuing to use the site after a change means you accept the updated terms.</p>`,
  },
  {
    title: 'Severability',
    html: `<p>If any part of these terms is found to be unenforceable, the rest of the terms remain in full effect.</p>`,
  },
  {
    title: 'Contact Us',
    html: `<p>If you have any questions about these Terms & Conditions, please reach us through our <a href="/contact-us/">Contact Us</a> page.</p>`,
  },
];

const bodyClass =
  'wp-singular page-template page-template-elementor_header_footer page page-id-2321 wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-2321';
---
<BaseLayout seo={seo} schema={schema} bodyClass={bodyClass}>
  <LegalPage
    pageId={2321}
    ids={{ hero: 'b18e754', heading: '7f97dcf', body: 'ab5e471', tocCol: '6dad446', toc: 'e175afc', textCol: '6094342', text: '5bed67c' }}
    title="Terms & Condition"
    updated={updated}
    sections={sections}
  />
</BaseLayout>
