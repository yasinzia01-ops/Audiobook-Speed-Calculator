        </tr>
      </thead>
      <tbody id="asc-chartBody"></tbody>
    </table>
  </div>
  <p class="tbl-note">Times rounded to nearest minute · Green = most time saved</p>
</div>
<script is:inline>
(function(){
  var lengths=[
    {label:"2 hours",mins:120},{label:"3 hours",mins:180},{label:"4 hours",mins:240},
    {label:"5 hours",mins:300},{label:"6 hours",mins:360},{label:"7 hours",mins:420},
    {label:"8 hours",mins:480},{label:"9 hours",mins:540},{label:"10 hours",mins:600},
    {label:"11 hours",mins:660},{label:"12 hours",mins:720},{label:"14 hours",mins:840},
    {label:"15 hours",mins:900},{label:"16 hours",mins:960},{label:"18 hours",mins:1080},
    {label:"20 hours",mins:1200},{label:"24 hours",mins:1440},{label:"30 hours",mins:1800},
    {label:"40 hours",mins:2400},{label:"50 hours",mins:3000}
  ];
  var speeds=[0.75,1,1.25,1.5,1.75,2,2.5,3];
  function fmtTime(m){
    var h=Math.floor(m/60),mn=Math.round(m%60);
    if(h===0)return mn+'m';
    if(mn===0)return h+'h';
    return h+'h '+mn+'m';
  }
  var tbody=document.getElementById('asc-chartBody');
  lengths.forEach(function(row){
    var tr=document.createElement('tr');
    var cells='<td>'+row.label+'</td>';
    speeds.forEach(function(spd){
      var result=Math.round(row.mins/spd);
      var cls='';
      if(spd===1)cls='base';
      else if(spd>=2)cls='faster';
      else if(spd>=1.25)cls='fast';
      else cls='save';
      cells+='<td class="'+cls+'">'+fmtTime(result)+'</td>';
    });
    tr.innerHTML=cells;
    tbody.appendChild(tr);
  });
})();
</script>        </div>
