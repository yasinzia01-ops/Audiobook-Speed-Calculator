.asc-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
.asc-wrap .tbl-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid #1f2937; }
.asc-wrap table { width: 100%; border-collapse: collapse; min-width: 780px; }
.asc-wrap thead tr { background: #0d1117; }
.asc-wrap th { padding: 13px 12px; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #6b7280; border-bottom: 2px solid #1f2937; text-align: center; white-space: nowrap; }
.asc-wrap th:first-child { text-align: left; color: #f9fafb; background: #111827; }
.asc-wrap th.spd { color: #22d3ee; }
.asc-wrap th.spd.fast { color: #4ade80; }
.asc-wrap tbody tr { border-bottom: 1px solid #111827; transition: background .1s; }
.asc-wrap tbody tr:hover { background: #0a0f1a; }
.asc-wrap tbody tr:last-child { border-bottom: none; }
.asc-wrap td { padding: 13px 12px; text-align: center; font-size: 13.5px; font-variant-numeric: tabular-nums; color: #9ca3af; }
.asc-wrap td:first-child { text-align: left; background: #0d1117; border-right: 1px solid #1f2937; font-weight: 800; color: #f9fafb; white-space: nowrap; padding-left: 18px; }
.asc-wrap td.base   { color: #f9fafb; font-weight: 700; }
.asc-wrap td.fast   { color: #22d3ee; font-weight: 700; }
.asc-wrap td.faster { color: #4ade80; font-weight: 700; }
.asc-wrap td.save   { font-size: 11px; color: #374151; }
.asc-wrap .tbl-note { font-size: 12px; color: #374151; margin-top: 12px; text-align: right; }
</style>
<div class="asc-wrap">
  <div class="tbl-wrap">
    <table>
      <thead>
        <tr>
          <th>Book Length</th>
          <th>0.75x<br><span style="font-size:9px;font-weight:500;color:#374151">Slower</span></th>
          <th class="base" style="color:#f9fafb">1x<br><span style="font-size:9px;font-weight:500;color:#374151">Normal</span></th>
          <th class="spd">1.25x<br><span style="font-size:9px;font-weight:500">Popular</span></th>
