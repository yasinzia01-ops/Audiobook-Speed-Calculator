---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/elementor/elementor-post-13.css';

const seo = {
  "title": "Page not found - Audiobook Speed Calculator",
  "noindex": true
};
---
<BaseLayout seo={seo} bodyClass="error404 wp-embed-responsive wp-theme-hello-elementor wp-schema-pro-2.11.4 hello-elementor-default elementor-default elementor-kit-6 elementor-page-13">
<div data-elementor-type="error-404" data-elementor-id="13" class="elementor elementor-13 elementor-location-single">
      <div class="elementor-element elementor-element-1fdbdb1 e-flex e-con-boxed e-con e-parent">
          <div class="e-con-inner">
    <div class="elementor-element elementor-element-28cb510 e-con-full e-flex e-con e-child">
        <div class="elementor-element elementor-element-7eadec7 elementor-widget elementor-widget-heading">
          <h1 class="elementor-heading-title elementor-size-default">404 Error</h1>        </div>
        <div class="elementor-element elementor-element-1024ee0 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-heading">
          <h2 class="elementor-heading-title elementor-size-default">Sorry, we couldn't find that page try going back to home page</h2>        </div>
        <div class="elementor-element elementor-element-c0140b8 elementor-align-center elementor-widget elementor-widget-button">
                    <a class="elementor-button elementor-button-link elementor-size-sm" href="/">
            <span class="elementor-button-content-wrapper">
                  <span class="elementor-button-text">Back To Home</span>
          </span>
          </a>
                </div>
        </div>
          </div>
        </div>
        </div>
</BaseLayout>
