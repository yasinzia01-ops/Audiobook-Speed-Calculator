            <details id="e-n-accordion-item-6190" class="e-n-accordion-item" open="">
        <summary class="e-n-accordion-item-title" data-accordion-index="1" tabindex="0" aria-expanded="true" aria-controls="e-n-accordion-item-6190">
          <span class="e-n-accordion-item-title-header"><h3 class="e-n-accordion-item-title-text"> Q. What speed do most people prefer for audiobooks? </h3></span>
              <span class="e-n-accordion-item-title-icon">
      <span class="e-opened"><i aria-hidden="true" class="icon icon-cross-circle"></i></span>
      <span class="e-closed"><i aria-hidden="true" class="icon icon-plus-circle"></i></span>
    </span>
