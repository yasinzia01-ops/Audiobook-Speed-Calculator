---
<BaseLayout seo={seo} schema={schema} bodyClass="home wp-singular page-template page-template-elementor_header_footer page page-id-590 wp-embed-responsive wp-theme-hello-elementor wp-schema-pro-2.11.4 hello-elementor-default elementor-default elementor-template-full-width elementor-kit-6 elementor-page elementor-page-590 elementor-page-17">
<div data-elementor-type="wp-page" data-elementor-id="590" class="elementor elementor-590">
        <div class="elementor-element elementor-element-3aa2550 e-flex e-con-boxed e-con e-parent" id="calculator">
          <div class="e-con-inner">
        <div class="elementor-element elementor-element-59781c1 elementor-icon-list--layout-inline elementor-align-center elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list">
              <ul class="elementor-icon-list-items elementor-inline-items">
              <li class="elementor-icon-list-item elementor-inline-item">
                    <span class="elementor-icon-list-text">✦ Free Audiobook Time Calculator · No sign-up · Instant Results</span>
                  </li>
            </ul>
            </div>
        <div class="elementor-element elementor-element-3e324c3 elementor-widget elementor-widget-heading">
          <h1 class="elementor-heading-title elementor-size-default">Audiobook Speed Calculator <br>
<span class="gradient-text">Find Your Exact Listening Time</span></h1>        </div>
          <h2 class="e-bdc8cd6-074af8c e-heading-base">Calculate Listening Time for Any Audiobook Length at 1.25x, 1.5x, 2x &amp; Custom Speeds</h2>
        <div class="elementor-element elementor-element-5986ba2 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor">
                  <p>Enter your audiobook length, pick a playback speed, and instantly calculate your adjusted listening time — plus exactly how much time you save at 1.25x, 1.5x, 2x, or any custom speed.</p>                </div>
        <div class="elementor-element elementor-element-87e23da elementor-widget elementor-widget-html">
<style is:inline>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg:       #0d1117;
    --card:     #161c26;
    --card2:    #1a2233;
    --border:   #232d3f;
    --text:     #ffffff;
    --muted:    #7a8ba0;
    --cyan:     #00d4ff;
    --btn-bg:   #1e2a3a;
    --btn-hov:  #263548;
    --track-bg: #2a3a50;
  }
  html { overflow-x: hidden; }
  body {
    font-family: 'Poppins', sans-serif;
    color: var(--text);
    overflow-x: hidden;
  }
  .wrap {
    width: 100%;
    max-width: 1060px;
    margin: 0 auto;
  }
  /* ── GRID: single col mobile, two col desktop ── */
  .grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .left, .right {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    min-width: 0;
  }
  /* ── CARD ── */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px 16px;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  /* ── BADGE ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0,212,255,0.08);
    border: 1px solid rgba(0,212,255,0.25);
    color: var(--cyan);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
    white-space: nowrap;
  }
  .badge svg { width: 13px; height: 13px; flex-shrink: 0; }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: nowrap;
  }
  .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--btn-bg);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: background .15s, color .15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .reset-btn:hover { background: var(--btn-hov); color: var(--text); }
  .reset-btn svg { width: 13px; height: 13px; }
  .card-title {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin-bottom: 4px;
    line-height: 1.2;
  }
  .card-sub {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  /* ── TIME ROW ── */
  .time-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    width: 100%;
  }
  .time-box {
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    overflow: hidden;
  }
  .time-box-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    min-width: 0;
  }
  .time-lbl {
    font-size: 9px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .7px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .tbtn-wrap {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .tbtn {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--btn-bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    transition: background .12s;
    font-family: 'Poppins', sans-serif;
    flex-shrink: 0;
    touch-action: manipulation;
  }
  .tbtn:hover  { background: var(--btn-hov); }
  .tbtn:active { transform: scale(.9); }
  .time-val {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -1px;
    line-height: 1;
    color: var(--text);
  }
  /* ── SPEED CARD ── */
  .speed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
    min-width: 0;
  }
  .speed-text { min-width: 0; flex: 1; }
  .speed-num {
    font-size: 46px;
    font-weight: 600;
    color: var(--cyan);
    letter-spacing: -2px;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* ── SLIDER ── */
  .slider-wrap { margin: 18px 0 8px; }
  input[type=range] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    background: var(--track-bg);
    display: block;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--cyan);
    cursor: pointer;
    box-shadow: 0 0 0 3px rgba(0,212,255,.18);
  }
  input[type=range]::-moz-range-thumb {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--cyan);
    border: none;
    cursor: pointer;
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    padding: 0 2px;
    margin-top: 6px;
  }
  .ticks span { font-size: 11px; color: var(--muted); font-weight: 500; }
  /* ── PILLS ── */
  .pills {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--btn-bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: background .12s, border-color .12s, color .12s;
    user-select: none;
    touch-action: manipulation;
  }
  .pill:hover { background: var(--btn-hov); }
  .pill.on {
    background: rgba(0,212,255,.1);
    border-color: var(--cyan);
    color: var(--cyan);
  }
  /* ── RESULT CARDS ── */
  .result-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    gap: 8px;
    flex-wrap: wrap;
  }
  .speed-tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }
  .big-time {
    font-size: clamp(36px, 12vw, 60px);
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--text);
    margin-bottom: 5px;
    word-break: keep-all;
  }
  .big-sub {
    font-size: 14px;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 16px;
  }
  .vs-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    gap: 8px;
  }
  .vs-lbl { font-size: 13px; color: var(--muted); }
  .vs-pct { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; }
  .bar-track {
    width: 100%;
    height: 5px;
    background: var(--track-bg);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    background: var(--cyan);
    border-radius: 3px;
    width: 0%;
    transition: width .4s ease;
  }
  .saved-big {
    font-size: clamp(34px, 11vw, 52px);
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--text);
    margin-bottom: 5px;
    word-break: keep-all;
  }
  .saved-sub {
    font-size: 14px;
    color: var(--muted);
  }
  .insight {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px 20px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
  }
  .insight b { color: var(--text); }
  /* ── DESKTOP: two column ── */
  @media (min-width: 720px) {
    .grid {
      flex-direction: row;
      align-items: flex-start;
    }
    .left, .right { width: 50%; }
    .card { padding: 26px 24px; }
    .card-title { font-size: 28px; }
    .time-val { font-size: 42px; }
    .time-lbl { font-size: 10px; }
    .tbtn { width: 26px; height: 26px; }
    .speed-num { font-size: 52px; }
    .ticks span { font-size: 11px; }
    .pill { padding: 8px 15px; font-size: 13px; }
  }
</style>
<div class="wrap">
  <div class="grid">
    <div class="left">
      <div class="card">
        <div class="card-top">
          <div class="badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Step 1
          </div>
          <button class="reset-btn" id="resetBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
            Reset
          </button>
        </div>
        <div class="card-title">Audiobook length</div>
        <div class="card-sub">Enter the total duration shown in your player.</div>
        <div class="time-row">
          <div class="time-box">
            <div class="time-box-top">
              <span class="time-lbl">Hours</span>
              <div class="tbtn-wrap">
                <button class="tbtn" id="hDec">−</button>
                <button class="tbtn" id="hInc">+</button>
              </div>
            </div>
            <div class="time-val" id="hVal">8</div>
          </div>
          <div class="time-box">
            <div class="time-box-top">
              <span class="time-lbl">Minutes</span>
              <div class="tbtn-wrap">
                <button class="tbtn" id="mDec">−</button>
                <button class="tbtn" id="mInc">+</button>
              </div>
            </div>
            <div class="time-val" id="mVal">30</div>
          </div>
          <div class="time-box">
            <div class="time-box-top">
              <span class="time-lbl">Seconds</span>
              <div class="tbtn-wrap">
                <button class="tbtn" id="sDec">−</button>
                <button class="tbtn" id="sInc">+</button>
              </div>
            </div>
            <div class="time-val" id="sVal">0</div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          Step 2
        </div>
        <div class="speed-header">
          <div class="speed-text">
            <div class="card-title">Playback speed</div>
            <div class="card-sub" style="margin-bottom:0">Drag to fine-tune from 0.5x to 5x.</div>
          </div>
          <div class="speed-num" id="speedNum">1.00x</div>
        </div>
        <div class="slider-wrap">
          <input type="range" id="slider" min="0.5" max="5" step="0.05" value="1">
          <div class="ticks">
            <span>0.5x</span><span>1x</span><span>2x</span><span>3x</span><span>4x</span><span>5x</span>
          </div>
        </div>
        <div class="pills" id="pillsWrap">
          <button class="pill" data-v="0.5">0.5x</button>
          <button class="pill on" data-v="1">1x</button>
          <button class="pill" data-v="1.25">1.25x</button>
          <button class="pill" data-v="1.5">1.5x</button>
          <button class="pill" data-v="1.75">1.75x</button>
          <button class="pill" data-v="2">2x</button>
          <button class="pill" data-v="2.5">2.5x</button>
          <button class="pill" data-v="3">3x</button>
        </div>
      </div>
    </div>
    <div class="right">
      <div class="card">
        <div class="result-top">
          <div class="badge" style="margin-bottom:0">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Listening time
          </div>
          <div class="speed-tag" id="speedAt">@ 1.00x</div>
        </div>
        <div class="big-time" id="listenTime">08:30:00</div>
        <div class="big-sub" id="listenSub">8 hr 30 min</div>
        <div class="vs-row">
          <span class="vs-lbl">vs. 1x playback</span>
          <span class="vs-pct" id="pctSaved">0% saved</span>
        </div>
        <div class="bar-track"><div class="bar-fill" id="barFill"></div></div>
      </div>
      <div class="card">
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
          Time saved
        </div>
        <div class="saved-big" id="savedTime">00:00:00</div>
        <div class="saved-sub" id="savedSub">less than a minute back in your day.</div>
      </div>
      <div class="insight" id="insight">
        <b>Insight.</b> A gentle bump. Most listeners find 1.25x feels almost natural.
      </div>
    </div>
  </div>
</div>
<script is:inline>
  var H = 8, M = 30, S = 0, SPD = 1.0;
  function p2(n){ return String(Math.max(0,Math.floor(n))).padStart(2,'0'); }
  function hms(sec){
    sec = Math.max(0,sec);
    return p2(Math.floor(sec/3600))+':'+p2(Math.floor((sec%3600)/60))+':'+p2(Math.floor(sec%60));
  }
  function human(sec){
    sec = Math.max(0,sec);
    var h=Math.floor(sec/3600), m=Math.floor((sec%3600)/60), s=Math.floor(sec%60);
    var o=[];
    if(h) o.push(h+' hr');
    if(m) o.push(m+' min');
    if(s&&!h) o.push(s+' sec');
    return o.length ? o.join(' ') : '0 sec';
  }
  function insight(spd){
    if(spd<=0.75) return 'Going slow — perfect for dense material or language learning.';
    if(spd<=0.99) return 'Slightly slower than normal. Great for technical or complex content.';
    if(spd<=1.05) return 'A gentle bump. Most listeners find 1.25x feels almost natural.';
    if(spd<=1.35) return 'Most listeners find this speed comfortable and natural-sounding.';
    if(spd<=1.65) return 'Efficient pace — you\'ll save meaningful time without losing much.';
    if(spd<=2.05) return 'Power listener mode. Takes a few sessions to fully adapt to this.';
    if(spd<=2.55) return 'Advanced territory — best for familiar or previously-heard content.';
    if(spd<=3.05) return 'Elite speed. Comprehension requires serious listening practice.';
    return 'Extreme speed — mostly for review or skimming key sections quickly.';
  }
  function update(){
    document.getElementById('hVal').textContent = H;
    document.getElementById('mVal').textContent = M;
    document.getElementById('sVal').textContent = S;
    var orig = H*3600 + M*60 + S;
    var newS = orig / SPD;
    var saved = Math.max(0, orig - newS);
    var pct = orig > 0 ? Math.min(100, Math.max(0,(saved/orig)*100)) : 0;
    document.getElementById('listenTime').textContent = hms(newS);
    document.getElementById('listenSub').textContent  = human(newS);
    document.getElementById('speedAt').textContent    = '@ '+SPD.toFixed(2)+'x';
    document.getElementById('pctSaved').textContent   = pct.toFixed(0)+'% saved';
    document.getElementById('barFill').style.width    = pct+'%';
    document.getElementById('savedTime').textContent  = hms(saved);
    document.getElementById('savedSub').textContent   = saved<60 ? 'less than a minute back in your day.'
      : saved<3600 ? Math.floor(saved/60)+' minutes back in your day.'
      : human(saved)+' back in your day.';
    document.getElementById('speedNum').textContent = SPD.toFixed(2)+'x';
    var pctSl = ((SPD-0.5)/(5-0.5))*100;
    var sl = document.getElementById('slider');
    sl.value = SPD;
    sl.style.background = 'linear-gradient(to right,#00d4ff '+pctSl+'%,#2a3a50 '+pctSl+'%)';
    document.querySelectorAll('.pill').forEach(function(p){
      p.classList.toggle('on', parseFloat(p.dataset.v)===SPD);
    });
    document.getElementById('insight').innerHTML = '<b>Insight.</b> '+insight(SPD);
  }
  function makeCounter(btnId, onChange){
    var btn = document.getElementById(btnId);
    var holdTimer=null, repeatTimer=null;
    function fire(){ onChange(); update(); }
    function start(){ fire(); holdTimer=setTimeout(function(){ repeatTimer=setInterval(fire,120); },400); }
    function stop(){ clearTimeout(holdTimer); clearInterval(repeatTimer); holdTimer=null; repeatTimer=null; }
    btn.addEventListener('mousedown', start);
    btn.addEventListener('touchstart', function(e){ e.preventDefault(); start(); },{passive:false});
    btn.addEventListener('mouseup', stop);
    btn.addEventListener('mouseleave', stop);
    btn.addEventListener('touchend', stop);
    btn.addEventListener('touchcancel', stop);
    btn.addEventListener('contextmenu', function(e){ e.preventDefault(); });
  }
  makeCounter('hInc', function(){ H=Math.min(99,H+1); });
  makeCounter('hDec', function(){ H=Math.max(0, H-1); });
  makeCounter('mInc', function(){ M=Math.min(59,M+1); });
  makeCounter('mDec', function(){ M=Math.max(0, M-1); });
  makeCounter('sInc', function(){ S=Math.min(59,S+1); });
  makeCounter('sDec', function(){ S=Math.max(0, S-1); });
  document.getElementById('slider').addEventListener('input',function(){
    SPD=parseFloat(this.value); update();
  });
  document.getElementById('pillsWrap').addEventListener('click',function(e){
    var p=e.target.closest('.pill');
    if(p){ SPD=parseFloat(p.dataset.v); update(); }
  });
  document.getElementById('resetBtn').addEventListener('click',function(){
    H=8; M=30; S=0; SPD=1.0; update();
  });
  update();
</script>
