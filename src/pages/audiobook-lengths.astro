function fmtTime(mins) {
  const h = Math.floor(mins / 60);
  const m = Math.round(mins % 60);
  if (h === 0) return `${m}m`;
  if (m === 0) return `${h}h`;
  return `${h}h ${m}m`;
}
function calcSpeed(mins, mult) { return fmtTime(Math.round(mins / mult)); }
let activeGenre = 'all';
function renderTable(data) {
  const tbody = document.getElementById('tableBody');
  tbody.innerHTML = '';
  data.forEach((b, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="rank">${i + 1}</td>
      <td>
        <div class="book-title">${b.title}${b.popular ? '<span class="popular-badge">Popular</span>' : ''}</div>
        <div class="book-author">${b.author}</div>
      </td>
      <td><span class="genre-tag">${b.genre}</span></td>
      <td class="runtime">${fmtTime(b.mins)}</td>
      <td class="speed-time">${calcSpeed(b.mins, 1.25)}</td>
      <td class="speed-time">${calcSpeed(b.mins, 1.5)}</td>
      <td class="speed-time fast">${calcSpeed(b.mins, 2)}</td>
    `;
    tbody.appendChild(tr);
  });
  document.getElementById('resultsCount').textContent = `Showing ${data.length} audiobooks`;
}
function filterTable() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const filtered = books.filter(b => {
    const matchGenre = activeGenre === 'all' || b.genre === activeGenre;
    const matchQ = b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q);
    return matchGenre && matchQ;
  });
  renderTable(filtered);
}
function setGenre(el, genre) {
  activeGenre = genre;
  document.querySelectorAll('.fp').forEach(fp => fp.classList.remove('active'));
  el.classList.add('active');
  filterTable();
}
renderTable(books);
