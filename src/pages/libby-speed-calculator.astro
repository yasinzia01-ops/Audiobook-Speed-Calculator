<style is:inline>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600&display=swap');
/* ── Reset ── */
.lsc-page *{box-sizing:border-box;margin:0;padding:0}
/* ── Page Wrapper ── */
.lsc-page{
  font-family:'Poppins',sans-serif;
  color:#fff;
  width:100vw;
  max-width:100vw;
  position:relative;
  left:50%;
  margin-left:-50vw;
  margin-top:-14px;
  margin-bottom:-30px;
  padding:56px max(20px,8%);
  line-height:1.75;
  background:#0d1117;
  box-sizing:border-box;
}
@media(max-width:900px){.lsc-page{padding:40px 28px;}}
@media(max-width:600px){.lsc-page{padding:28px 16px;}}
/* ── Breadcrumb ── */
.lsc-breadcrumb{font-size:13px;color:#7a8ba0;margin-bottom:28px}
.lsc-breadcrumb a{color:#00d4ff;text-decoration:none}
.lsc-breadcrumb span{margin:0 6px;color:#232d3f}
/* ── Meta bar ── */
.lsc-meta{display:flex;gap:20px;margin-bottom:28px;font-size:13px;color:#7a8ba0;flex-wrap:wrap;align-items:center}
.lsc-meta .tag{background:#1a2233;border:1px solid #232d3f;color:#00d4ff;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600}
/* ── Typography ── */
.lsc-page h1{font-family:'Inter',sans-serif;font-size:clamp(26px,5vw,38px);font-weight:800;color:#fff;line-height:1.15;margin-bottom:20px}
.lsc-page .intro{font-size:17px;color:rgba(255,255,255,.8);margin-bottom:36px;padding-bottom:32px;border-bottom:1px solid #232d3f;line-height:1.7}
.lsc-page h2{font-family:'Inter',sans-serif;font-size:clamp(18px,3.5vw,22px);font-weight:700;color:#fff;margin-top:52px;margin-bottom:0;padding-bottom:12px;border-bottom:2px solid #232d3f}
.lsc-page h3{font-family:'Inter',sans-serif;font-size:16px;font-weight:600;color:#00d4ff;margin-top:28px;margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px}
.lsc-page p{color:rgba(255,255,255,.72);font-size:15.5px;margin-bottom:16px;margin-top:16px}
.lsc-page ul,.lsc-page ol{color:rgba(255,255,255,.72);font-size:15.5px;padding-left:22px;margin:16px 0}
.lsc-page li{margin-bottom:8px;line-height:1.65}
.lsc-page strong{color:#fff;font-weight:600}
.lsc-page a{color:#00d4ff;text-decoration:underline}
/* ── Direct Answer Box ── */
.lsc-answer{background:#161c26;border-left:4px solid #00d4ff;border-radius:0 8px 8px 0;padding:20px 24px;margin:16px 0 24px}
.lsc-answer .aa-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#00d4ff;margin-bottom:10px;display:block}
.lsc-answer p{color:#fff;font-size:15.5px;font-weight:500;margin:0;line-height:1.65}
/* ── Callout ── */
.lsc-callout{background:#1a2233;border-radius:10px;padding:20px 24px;margin:24px 0;border-left:4px solid #00d4ff}
.lsc-callout.tip{border-left-color:#4ade80}
.lsc-callout.warning{border-left-color:#f59e0b}
.lsc-callout h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#00d4ff;margin-bottom:10px}
.lsc-callout.tip h4{color:#4ade80}
.lsc-callout.warning h4{color:#f59e0b}
.lsc-callout p{color:rgba(255,255,255,.75);font-size:14px;margin:0;line-height:1.65}
/* ── Table ── */
.lsc-page table{width:100%;border-collapse:collapse;margin:24px 0;font-size:14px}
.lsc-page thead tr{background:#1a2233}
.lsc-page th{padding:12px 16px;text-align:left;color:#00d4ff;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.lsc-page td{padding:11px 16px;border-bottom:1px solid #232d3f;color:rgba(255,255,255,.72)}
.lsc-page tr:nth-child(even) td{background:#161c26}
.lsc-page td strong{color:#fff}
.lsc-page td.highlight{color:#00d4ff;font-weight:700}
/* ══════════════════════════════════════════
   CALCULATOR STYLES
══════════════════════════════════════════ */
.calc-wrapper{background:#161c26;border:1px solid #232d3f;border-top:3px solid #00d4ff;border-radius:14px;padding:32px;margin:32px 0}
.calc-tabs{display:flex;gap:0;border-bottom:1px solid #232d3f;margin-bottom:28px}
.calc-tab{padding:10px 24px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;color:#7a8ba0;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;background:none;border-top:none;border-left:none;border-right:none}
.calc-tab.active{color:#00d4ff;border-bottom-color:#00d4ff}
.calc-tab:hover:not(.active){color:rgba(255,255,255,.6)}
.calc-panel{display:none}
.calc-panel.active{display:block}
.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
@media(max-width:600px){.calc-grid{grid-template-columns:1fr}}
.calc-field label{display:block;font-size:12px;font-weight:600;color:#7a8ba0;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px}
.calc-field.full{grid-column:1/-1}
.calc-input-row{display:flex;gap:8px;align-items:center}
.calc-input-row input,.calc-field input,.calc-field select{
  width:100%;background:#0d1117;border:1px solid #232d3f;color:#fff;
  padding:12px 16px;border-radius:8px;font-size:15px;font-family:'Inter',sans-serif;
  outline:none;transition:border-color .2s;
}
.calc-input-row input{flex:1}
.calc-input-row span{color:#7a8ba0;font-size:13px;white-space:nowrap}
.calc-field input:focus,.calc-field select:focus,.calc-input-row input:focus{border-color:#00d4ff}
.calc-field select option{background:#161c26}
.calc-btn{
  width:100%;padding:16px;background:#00d4ff;color:#0d1117;
  font-family:'Inter',sans-serif;font-weight:700;font-size:16px;
  border:none;border-radius:8px;cursor:pointer;transition:opacity .2s;
  margin-top:4px;
}
.calc-btn:hover{opacity:.88}
/* Result cards */
.calc-results{display:none;margin-top:24px;padding-top:24px;border-top:1px solid #232d3f}
.calc-results.show{display:block}
.result-headline{font-family:'Inter',sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#7a8ba0;margin-bottom:16px}
.result-primary{background:#0d1117;border:2px solid #00d4ff;border-radius:12px;padding:24px;text-align:center;margin-bottom:16px}
.result-primary .rp-label{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#00d4ff;margin-bottom:8px;display:block}
.result-primary .rp-value{font-family:'Inter',sans-serif;font-size:42px;font-weight:800;color:#fff;line-height:1}
.result-primary .rp-sub{font-size:13px;color:#7a8ba0;margin-top:8px}
.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
@media(max-width:600px){.result-grid{grid-template-columns:1fr}}
.result-card{background:#1a2233;border-radius:10px;padding:16px;text-align:center;border:1px solid #232d3f}
.result-card.can-do{border-color:#22c55e}
.result-card.cannot{border-color:#ef4444;opacity:.7}
.result-card .rc-speed{font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#00d4ff;margin-bottom:4px}
.result-card .rc-time{font-size:13px;color:#fff;font-weight:600;margin-bottom:4px}
.result-card .rc-status{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px}
.result-card.can-do .rc-status{color:#22c55e}
.result-card.cannot .rc-status{color:#ef4444}
.result-note{background:#1a2233;border-radius:8px;padding:14px 18px;font-size:13px;color:rgba(255,255,255,.65);border-left:3px solid #4ade80}
/* ── CTA Block ── */
.lsc-cta{background:linear-gradient(135deg,#0d1f35 0%,#1a2233 100%);border:1px solid #232d3f;border-top:3px solid #00d4ff;border-radius:12px;padding:36px;text-align:center;margin:52px 0}
.lsc-cta h3{font-family:'Inter',sans-serif;color:#fff;font-size:22px;font-weight:700;margin-bottom:12px}
.lsc-cta p{color:rgba(255,255,255,.65);font-size:15px;margin-bottom:24px}
.lsc-cta a.btn{display:inline-block;background:#00d4ff;color:#0d1117;font-weight:700;padding:14px 32px;border-radius:8px;text-decoration:none;font-size:15px;font-family:'Inter',sans-serif}
/* ── Spoke Pages Navigation ── */
.spoke-nav{background:#161c26;border:1px solid #232d3f;border-radius:12px;padding:28px;margin:52px 0}
.spoke-nav h3{font-family:'Inter',sans-serif;font-size:16px;font-weight:700;color:#fff;margin-bottom:6px}
.spoke-nav .sn-sub{font-size:13px;color:#7a8ba0;margin-bottom:20px}
.spoke-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.spoke-list li a{
  display:flex;align-items:center;gap:12px;
  background:#0d1117;border:1px solid #232d3f;border-radius:8px;
  padding:12px 18px;color:rgba(255,255,255,.8);text-decoration:none;
  font-size:14px;font-weight:500;transition:border-color .2s,color .2s;
}
.spoke-list li a:hover{border-color:#00d4ff;color:#fff}
.spoke-list li a::before{content:'→';color:#00d4ff;font-weight:700;flex-shrink:0}
/* ── FAQ ── */
.lsc-faq{margin-top:56px;padding-top:40px;border-top:1px solid #232d3f}
.lsc-faq h2{margin-top:0;border-bottom:none;padding-bottom:0}
.faq-item{background:#161c26;border-radius:10px;padding:22px 24px;margin:16px 0;border:1px solid #232d3f;cursor:pointer;user-select:none}
.faq-item h3.fq{font-family:'Inter',sans-serif;font-size:16px;font-weight:600;color:#fff;margin:0;padding:0;text-transform:none;letter-spacing:0;border-bottom:none;display:flex;justify-content:space-between;align-items:center;gap:12px;line-height:1.45;}
.faq-icon{font-size:22px;color:#00d4ff;font-weight:300;flex-shrink:0;transition:transform .25s}
.faq-item.open .faq-icon{transform:rotate(45deg)}
.faq-item .fa{display:none;font-size:14px;color:rgba(255,255,255,.7);line-height:1.65;margin-top:12px;padding-top:12px;border-top:1px solid #232d3f}
</style>
<div class="lsc-page">
  <nav class="lsc-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>›</span>
    <span>Libby Speed Calculator</span>
  </nav>
  <div class="lsc-meta">
    <span class="tag">Libby · Calculator Tool</span>
    <span>Free · No sign-up</span>
    <span>Updated July 2026</span>
  </div>
  <h1>Libby Speed Calculator</h1>
  <p class="intro">Enter your Libby audiobook length, how many days are left on your loan, and how many hours per day you can listen - get the minimum playback speed you need to finish before your loan expires. Also use Tab 2 to find your adjusted listening time at any speed.</p>
  <div class="calc-wrapper">
    <div class="calc-tabs">
      <button class="calc-tab active" onclick="switchTab('deadline')">Loan Deadline Calculator</button>
      <button class="calc-tab" onclick="switchTab('speed')">Speed Calculator</button>
    </div>
    <div class="calc-panel active" id="panel-deadline">
      <div class="calc-grid">
        <div class="calc-field full">
          <label>Audiobook Length (remaining)</label>
          <div class="calc-input-row">
            <input type="number" id="dl-hours" placeholder="0" min="0" max="100">
            <span>hr</span>
            <input type="number" id="dl-minutes" placeholder="0" min="0" max="59">
            <span>min</span>
          </div>
        </div>
        <div class="calc-field">
          <label>Days Left on Loan</label>
          <input type="number" id="dl-days" placeholder="e.g. 7" min="1" max="21">
        </div>
        <div class="calc-field">
          <label>Hours You Can Listen / Day</label>
          <input type="number" id="dl-hpd" placeholder="e.g. 2" min="0.5" max="24" step="0.5">
        </div>
      </div>
      <button class="calc-btn" onclick="calcDeadline()">Calculate Minimum Speed →</button>
      <div class="calc-results" id="dl-results">
        <div class="result-headline">Your Results</div>
        <div class="result-primary">
          <span class="rp-label">Minimum Speed Needed</span>
          <div class="rp-value" id="dl-min-speed">—</div>
          <div class="rp-sub" id="dl-sub">to finish before your loan expires</div>
        </div>
        <div class="result-grid">
          <div class="result-card" id="card-1x">
            <div class="rc-speed">1x</div>
            <div class="rc-time" id="time-1x">—</div>
            <div class="rc-status" id="status-1x">—</div>
          </div>
          <div class="result-card" id="card-15x">
            <div class="rc-speed">1.5x</div>
            <div class="rc-time" id="time-15x">—</div>
            <div class="rc-status" id="status-15x">—</div>
          </div>
          <div class="result-card" id="card-2x">
            <div class="rc-speed">2x</div>
            <div class="rc-time" id="time-2x">—</div>
            <div class="rc-status" id="status-2x">—</div>
          </div>
        </div>
        <div class="result-note" id="dl-note"></div>
      </div>
    </div>
    <div class="calc-panel" id="panel-speed">
      <div class="calc-grid">
        <div class="calc-field full">
          <label>Audiobook Length</label>
          <div class="calc-input-row">
            <input type="number" id="sp-hours" placeholder="0" min="0" max="100">
            <span>hr</span>
            <input type="number" id="sp-minutes" placeholder="0" min="0" max="59">
            <span>min</span>
          </div>
        </div>
        <div class="calc-field full">
          <label>Libby Playback Speed</label>
          <select id="sp-speed">
            <option value="">Select speed</option>
            <option value="0.5">0.5x</option>
            <option value="0.75">0.75x</option>
            <option value="1.0">1.0x (Normal)</option>
            <option value="1.1">1.1x</option>
            <option value="1.2">1.2x</option>
            <option value="1.25">1.25x</option>
            <option value="1.3">1.3x</option>
            <option value="1.4">1.4x</option>
            <option value="1.5">1.5x</option>
            <option value="1.6">1.6x</option>
            <option value="1.7">1.7x</option>
            <option value="1.75">1.75x</option>
            <option value="1.8">1.8x</option>
            <option value="1.9">1.9x</option>
            <option value="2.0">2.0x</option>
            <option value="2.5">2.5x</option>
            <option value="3.0">3.0x (Max)</option>
          </select>
        </div>
      </div>
      <button class="calc-btn" onclick="calcSpeed()">Calculate Listening Time →</button>
