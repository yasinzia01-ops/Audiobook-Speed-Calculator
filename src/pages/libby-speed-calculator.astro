<script is:inline>
/* ── Tab switching ── */
function switchTab(tab){
  document.querySelectorAll('.calc-tab').forEach(function(t,i){
    t.classList.toggle('active', (tab==='deadline' && i===0)||(tab==='speed' && i===1));
  });
  document.getElementById('panel-deadline').classList.toggle('active', tab==='deadline');
  document.getElementById('panel-speed').classList.toggle('active', tab==='speed');
}
/* ── Format hours to "Xhr Ymin" ── */
function fmtH(h){
  var hr=Math.floor(h), mn=Math.round((h-hr)*60);
  if(mn===60){hr++;mn=0;}
  if(hr===0) return mn+'m';
  if(mn===0) return hr+'h';
  return hr+'h '+mn+'m';
}
/* ── TAB 1: Deadline Calculator ── */
function calcDeadline(){
  var bh=parseFloat(document.getElementById('dl-hours').value)||0;
  var bm=parseFloat(document.getElementById('dl-minutes').value)||0;
  var days=parseFloat(document.getElementById('dl-days').value)||0;
  var hpd=parseFloat(document.getElementById('dl-hpd').value)||0;
  var bookLen = bh + bm/60;
  var avail = days * hpd;
  if(bookLen<=0||avail<=0){
    alert('Please fill in all fields.');
    return;
  }
  var minSpeed = bookLen / avail;
  var minSpeedRounded = Math.ceil(minSpeed*10)/10;
  document.getElementById('dl-min-speed').textContent = minSpeedRounded.toFixed(1)+'x';
  document.getElementById('dl-sub').textContent =
    'to finish '+fmtH(bookLen)+' in '+days+' day'+(days!==1?'s':'')+' ('+fmtH(avail)+' available)';
  function setCard(id, timeId, statusId, speed){
    var timeNeeded = bookLen/speed;
    var canDo = avail >= timeNeeded;
    var c = document.getElementById(id);
    c.className = 'result-card '+(canDo?'can-do':'cannot');
    document.getElementById(timeId).textContent = fmtH(timeNeeded)+' needed';
    document.getElementById(statusId).textContent = canDo ? '✓ Finishable' : '✗ Not enough time';
  }
  setCard('card-1x','time-1x','status-1x',1);
  setCard('card-15x','time-15x','status-15x',1.5);
  setCard('card-2x','time-2x','status-2x',2);
  var note = '';
  if(minSpeed<=1) note = 'You can finish at normal speed (1x). No speed increase needed.';
  else if(minSpeed<=1.5) note = 'Set Libby to 1.5x and you will finish comfortably before your loan expires.';
  else if(minSpeed<=2) note = 'You need 1.5x to 2x speed. Set Libby to '+minSpeedRounded.toFixed(1)+'x or higher.';
  else if(minSpeed<=3) note = 'You need '+minSpeedRounded.toFixed(1)+'x speed - this is an advanced speed. Check if early renewal is available first.';
  else note = 'The required speed exceeds Libby\'s 3x maximum. Consider renewing your loan or returning and re-borrowing.';
  document.getElementById('dl-note').textContent = note;
  document.getElementById('dl-results').classList.add('show');
}
/* ── TAB 2: Speed Calculator ── */
function calcSpeed(){
  var bh=parseFloat(document.getElementById('sp-hours').value)||0;
  var bm=parseFloat(document.getElementById('sp-minutes').value)||0;
  var spd=parseFloat(document.getElementById('sp-speed').value)||0;
  var bookLen = bh + bm/60;
  if(bookLen<=0||spd<=0){alert('Please fill in all fields.');return;}
  var adjusted = bookLen/spd;
  var saved = bookLen - adjusted;
  var pct = ((saved/bookLen)*100).toFixed(0);
  document.getElementById('sp-adjusted').textContent = fmtH(adjusted);
  document.getElementById('sp-saved').textContent = saved>0 ? fmtH(saved) : '0m';
  document.getElementById('sp-pct').textContent = pct+'% faster than 1x speed';
  document.getElementById('sp-note').textContent =
    'Your '+fmtH(bookLen)+' Libby audiobook takes '+fmtH(adjusted)+' at '+spd+'x speed, saving '+fmtH(saved)+' of listening time.';
  document.getElementById('sp-results').classList.add('show');
}
/* ── Accordion FAQ ── */
(function(){
  document.querySelectorAll('.faq-item').forEach(function(item){
    var q=item.querySelector('.fq');
    var a=item.querySelector('.fa');
    var icon=document.createElement('span');
    icon.className='faq-icon';icon.textContent='+';
    q.style.cursor='pointer';
    q.appendChild(icon);
    q.addEventListener('click',function(){
      var open=item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function(x){
        x.classList.remove('open');
        x.querySelector('.fa').style.display='none';
      });
      if(!open){item.classList.add('open');a.style.display='block';}
    });
  });
})();
</script>        </div>
